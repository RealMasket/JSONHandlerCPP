file(GLOB inputs "${TEST_ROOT}/*.json")
list(LENGTH inputs input_count)
if(NOT input_count EQUAL 18)
    message(FATAL_ERROR "Expected 18 deterministic profile fixtures, got ${input_count}")
endif()
execute_process(COMMAND "${BENCHMARK}" --stages --iterations 1 --samples 1
    --csv "${TEST_ROOT}/timing.csv" ${inputs} RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Dataset/semantic check failed: ${output}\n${error}")
endif()
file(READ "${TEST_ROOT}/timing.csv" timing)
if(NOT timing MATCHES "lex_only" OR NOT timing MATCHES "input_copy")
    message(FATAL_ERROR "Uninstrumented stage timing rows missing")
endif()
if(DEFINED PROFILE AND NOT PROFILE STREQUAL "")
    execute_process(COMMAND "${PROFILE}" ${inputs} RESULT_VARIABLE result
        OUTPUT_VARIABLE memory ERROR_VARIABLE error)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Memory profiling failed: ${error}")
    endif()
    file(WRITE "${TEST_ROOT}/memory.csv" "${memory}")
    string(REPLACE "\r\n" "\n" memory "${memory}")
    string(REPLACE "\n" ";" rows "${memory}")
    list(REMOVE_AT rows 0)
    set(count 0)
    foreach(row IN LISTS rows)
        if(row STREQUAL "")
            continue()
        endif()
        string(REPLACE "," ";" fields "${row}")
        list(LENGTH fields columns)
        if(NOT columns EQUAL 29)
            message(FATAL_ERROR "Invalid memory CSV column count: ${row}")
        endif()
        list(GET fields 6 peak)
        list(GET fields 8 retained)
        list(GET fields 10 after_bytes)
        list(GET fields 11 after_blocks)
        set(total 0)
        foreach(index RANGE 12 17)
            list(GET fields ${index} bytes)
            math(EXPR total "${total}+${bytes}")
        endforeach()
        if(peak LESS retained OR NOT total EQUAL retained OR NOT after_bytes EQUAL 0 OR NOT after_blocks EQUAL 0)
            message(FATAL_ERROR "Memory accounting mismatch: ${row}")
        endif()
        math(EXPR count "${count}+1")
    endforeach()
    if(NOT count EQUAL 54)
        message(FATAL_ERROR "Expected three memory stages per fixture")
    endif()
endif()
