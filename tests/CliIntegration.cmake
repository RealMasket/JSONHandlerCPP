if(NOT EXISTS "${CLI}")
    message(FATAL_ERROR "CLI executable not found: ${CLI}")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
set(valid "${TEST_ROOT}/valid file.json")
set(invalid "${TEST_ROOT}/invalid.json")
set(output "${TEST_ROOT}/output.json")
file(WRITE "${valid}" "{\"id\":\"001\",\"values\":[1,2.5,true]}")
file(WRITE "${invalid}" "{\n  \"id\":\n}")

function(run expected)
    execute_process(COMMAND "${CLI}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${result}\n${out}\n${err}")
    endif()
    string(REPLACE "\r\n" "\n" out "${out}")
    set(stdout "${out}" PARENT_SCOPE)
    set(stderr "${err}" PARENT_SCOPE)
endfunction()

run(0 --help)
if(NOT stdout MATCHES "Usage:")
    message(FATAL_ERROR "Help text is missing")
endif()
run(0 --version)
if(NOT stdout STREQUAL "masket-json ${EXPECTED_VERSION}\n" OR NOT stderr STREQUAL "")
    message(FATAL_ERROR "Unexpected version output: ${stdout} ${stderr}")
endif()
run(2)
run(2 unknown "${valid}")
run(2 check)
run(2 check --compact "${valid}")
run(2 format --unknown "${valid}")
run(2 format --output)
run(2 check "${valid}" "${valid}")
run(0 check "${valid}")
if(NOT stdout STREQUAL "Valid JSON\n" OR NOT stderr STREQUAL "")
    message(FATAL_ERROR "Unexpected validation output: ${stdout} ${stderr}")
endif()
run(1 check "${invalid}")
if(NOT stderr MATCHES "line 3, column 1" OR NOT stderr MATCHES "\\^")
    message(FATAL_ERROR "Missing source diagnostic: ${stderr}")
endif()
run(3 check "${TEST_ROOT}/missing.json")
run(0 format --compact "${valid}")
if(NOT stdout STREQUAL "{\"id\":\"001\",\"values\":[1,2.5,true]}\n")
    message(FATAL_ERROR "Unexpected compact output: ${stdout}")
endif()
run(0 format -o "${output}" "${valid}")
if(NOT stdout STREQUAL "")
    message(FATAL_ERROR "Output-file mode must not write to stdout")
endif()
file(READ "${output}" pretty)
if(NOT pretty MATCHES "\n  \"id\": \"001\"")
    message(FATAL_ERROR "Expected pretty output: ${pretty}")
endif()
run(0 check "${output}")
run(1 format -o "${output}" "${invalid}")
file(READ "${output}" after)
if(NOT after STREQUAL pretty)
    message(FATAL_ERROR "Invalid input overwrote an existing output file")
endif()
run(3 format -o "${TEST_ROOT}/missing/output.json" "${valid}")
execute_process(COMMAND "${CLI}" format --compact - INPUT_FILE "${valid}"
    RESULT_VARIABLE result OUTPUT_VARIABLE piped ERROR_VARIABLE err)
if(NOT result EQUAL 0 OR NOT piped MATCHES "001")
    message(FATAL_ERROR "stdin formatting failed: ${result} ${err}")
endif()
string(ASCII 26 control_z)
file(WRITE "${TEST_ROOT}/control-z.json" "null${control_z}garbage")
execute_process(COMMAND "${CLI}" check - INPUT_FILE "${TEST_ROOT}/control-z.json"
    RESULT_VARIABLE result)
if(NOT result EQUAL 1)
    message(FATAL_ERROR "stdin must preserve and reject raw Ctrl-Z bytes")
endif()
file(WRITE "${TEST_ROOT}/-leading.json" "null")
execute_process(COMMAND "${CLI}" check -- -leading.json
    WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Option terminator failed")
endif()

file(WRITE "${TEST_ROOT}/integers.json"
    "[9007199254740993,-9223372036854775808,18446744073709551615]")
run(0 format --compact "${TEST_ROOT}/integers.json")
if(NOT stdout STREQUAL "[9007199254740993,-9223372036854775808,18446744073709551615]\n")
    message(FATAL_ERROR "CLI rounded an integer: ${stdout}")
endif()
file(WRITE "${TEST_ROOT}/overflow.json" "18446744073709551616")
run(1 format -o "${output}" "${TEST_ROOT}/overflow.json")
file(READ "${output}" after)
if(NOT after STREQUAL pretty)
    message(FATAL_ERROR "Integer overflow overwrote an existing output file")
endif()
