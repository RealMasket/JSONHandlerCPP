file(MAKE_DIRECTORY "${TEST_ROOT}")
set(input "${TEST_ROOT}/invalid.bin")
set(artifacts "${TEST_ROOT}/artifacts")
file(WRITE "${input}" "{\"unfinished\":")
execute_process(COMMAND "${REPLAY}" --require-valid --artifacts "${artifacts}" "${input}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 1 OR NOT err MATCHES "Regression input was unexpectedly rejected")
    message(FATAL_ERROR "Expected a visible regression failure: ${result} ${out} ${err}")
endif()
file(READ "${input}" expected HEX)
file(READ "${artifacts}/reproducer.bin" actual HEX)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Reproducer bytes were changed")
endif()
file(READ "${artifacts}/failure.txt" details)
if(NOT details MATCHES "seed=20261105" OR NOT details MATCHES "stage=corpus:")
    message(FATAL_ERROR "Missing reproduction metadata")
endif()
# Invalid JSON is an expected result when replayed without --require-valid.
execute_process(COMMAND "${REPLAY}" "${artifacts}/reproducer.bin"
    RESULT_VARIABLE replay_result OUTPUT_VARIABLE replay_out ERROR_VARIABLE replay_err)
if(NOT replay_result EQUAL 0 OR NOT replay_out MATCHES "rejected=1")
    message(FATAL_ERROR "Invalid source was incorrectly treated as a crash: ${replay_err}")
endif()
